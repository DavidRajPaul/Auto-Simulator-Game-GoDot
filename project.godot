[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://translations/ui.en.translation", "res://translations/ui.ta.translation")
locale/fallback="en"

[layer_names]

3d_physics/layer_1="Environment_Roads"
3d_physics/layer_2="Player_Auto"
3d_physics/layer_3="AI_Traffic"
3d_physics/layer_4="Pedestrians_Props"
3d_physics/layer_5="Waterlogging_Zones"
3d_physics/layer_6="Pickup_Dropoff_Triggers"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8
3d/default_gravity=9.8
3d/default_linear_damp=0.05
3d/default_angular_damp=0.1
; The real-size (1 : 1) map spans ~7 km; Jolt clips WorldBoundaryShape3D to this size (default 2 km).
jolt_physics_3d/limits/world_boundary_shape_size=20000.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
