<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+: asked at runtime by NammaReminderPlugin.requestPermission(), never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Godot v2 plugin registration: the name after "v2." must equal getPluginName(). -->
        <meta-data
            android:name="org.godotengine.plugin.v2.NammaReminder"
            android:value="com.davidrajpaul.nammaauto.reminder.NammaReminderPlugin" />
    </application>
</manifest>
