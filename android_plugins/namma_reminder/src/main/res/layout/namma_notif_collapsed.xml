<?xml version="1.0" encoding="utf-8"?>
<!--
    Collapsed reminder (DecoratedCustomViewStyle content area; Android 12+ gives it about 48 dp).
    Colours are fixed (own gradient background), so light and dark shades read the same.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/namma_notif_root"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/namma_notif_bg_bonus"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/namma_notif_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/namma_notif_icon_bonus" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/namma_notif_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDy="1.5"
            android:shadowRadius="2"
            android:textColor="#FFFFC21A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/namma_notif_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFF6E3"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/namma_notif_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:background="@drawable/namma_notif_chip_yellow"
        android:fontFamily="sans-serif-black"
        android:paddingStart="10dp"
        android:paddingTop="3dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:textColor="#FF261A00"
        android:textSize="13sp" />
</LinearLayout>
