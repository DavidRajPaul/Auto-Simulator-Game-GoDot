<?xml version="1.0" encoding="utf-8"?>
<!--
    Expanded reminder card: gradient, hero art in the right half (fitEnd keeps it whole on phones and
    tablets), title / body / "Claim" pill on the left, reward chip top-right. The real action button
    (NotificationCompat.addAction) sits under the card, added by the system.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/namma_notif_root"
    android:layout_width="match_parent"
    android:layout_height="168dp"
    android:background="@drawable/namma_notif_bg_bonus">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- spacer (RemoteViews allows no plain View) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/namma_notif_art"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitEnd"
            android:src="@drawable/namma_notif_art_bonus" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="58"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/namma_notif_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="2"
                android:shadowColor="#B3000000"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:textColor="#FFFFC21A"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/namma_notif_body"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="3"
                android:shadowColor="#80000000"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textColor="#FFFFF6E3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/namma_notif_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/namma_notif_cta"
                android:fontFamily="sans-serif-black"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="9dp"
                android:textAllCaps="true"
                android:textColor="#FF261A00"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="42">

            <TextView
                android:id="@+id/namma_notif_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/namma_notif_chip_red"
                android:fontFamily="sans-serif-black"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:shadowColor="#66000000"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
